[Unit]
Description=Run the OSAF site monitor every 15 minutes
Documentation=https://github.com/rlmx-tech/osaf

[Timer]
# Every 15 minutes. The first version also had OnCalendar=*-*-* *:*:00, which
# fired every minute and fetched an OSM tile each time.
OnCalendar=*:0/15
Persistent=true
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
