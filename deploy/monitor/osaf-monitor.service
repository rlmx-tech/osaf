[Unit]
Description=OSAF external site monitor (tiles/CSP/API/bundle)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Runs from the git checkout, so a `git pull` updates it. Silent when healthy;
# on drift it prints the issues and exits 1. Add OnFailure= under [Unit] to
# route that to a notifier.
ExecStart=/opt/osaf/deploy/monitor/osaf_monitor.sh
TimeoutStartSec=120
