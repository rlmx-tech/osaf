# OSAF Production Environment Variables
# Copy this file to .env and fill in values before deploying.
# Store .env securely — do NOT commit it to git.

# ── Database ──────────────────────────────────────────────
POSTGRES_DB=osaf
POSTGRES_USER=osaf
POSTGRES_PASSWORD=<generate: openssl rand -base64 32>

# ── API ───────────────────────────────────────────────────
SECRET_KEY=<generate: openssl rand -base64 64>
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
CORS_ORIGINS=https://osaf.net,https://www.osaf.net

# Bind the gateway only to the private origin address used by your reverse proxy.
OSAF_BIND_ADDRESS=127.0.0.1
OSAF_BIND_PORT=80
# Narrow address or CIDR of that trusted proxy, used to recover client IPs safely.
TRUSTED_PROXY_CIDR=127.0.0.1/32

# ── Collector service ─────────────────────────────────────
# Username/password for the collector's service account in OSAF.
# Create this user as admin after first deploy via:
#   POST /api/v1/auth/register  { email, username, password }
#   PUT  /api/v1/admin/users/{id}/role  { role: "verified_contributor" }
COLLECTOR_USERNAME=collector
COLLECTOR_PASSWORD=<generate: openssl rand -base64 32>

# Ollama Cloud — optional; collector still runs without it
COLLECTOR_OLLAMA_URL=https://api.ollama.com
COLLECTOR_OLLAMA_API_KEY=
COLLECTOR_OLLAMA_MODEL=qwen3-coder:480b

# Reddit API — optional; leave blank to skip Reddit polling
COLLECTOR_REDDIT_CLIENT_ID=
COLLECTOR_REDDIT_CLIENT_SECRET=
